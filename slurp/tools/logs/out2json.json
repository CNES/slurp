{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "simple": {
      "format": "%(levelname)s: %(message)s",
      "datefmt": "%Y-%m-%dT%H:%M:%S%z"
    }
  },
  "handlers": {
    "file": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "INFO",
      "formatter": "simple",
      "filename": "slurp/tools/logs/out_logs.log",
      "maxBytes": 10000,
      "backupCount": 3
    }
  },
  "loggers": {
    "slurp": {
      "level": "DEBUG",
      "handlers": [
        "file"
      ]
    }
  }
}